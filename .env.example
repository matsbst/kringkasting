# Public origin of your instance (scheme + host), used for absolute URLs
# in the RSS feeds and page metadata. Set this when running behind a
# reverse proxy or CDN so the URLs don't reflect the internal request Host.
APP_ORIGIN=https://kringkasting.example.com

# Enable the admin dashboard at /admin. Unset = admin disabled.
# Use a long random string, e.g. `openssl rand -hex 24`.
ADMIN_TOKEN=

# Optional: server-side error reporting over the Sentry protocol
# (works with a self-hosted Bugsink instance). Unset = disabled.
SENTRY_DSN=

# Optional: cookieless Umami analytics. Both must be set to load the
# tracking script; unset = no analytics. Point these at YOUR own Umami
# instance — the website id is public, but the traffic is yours.
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# Where the SQLite database lives inside the container. The default is
# fine; only change it if you mount the data volume elsewhere.
# KRINGKASTING_DB_PATH=/app/data/kringkasting.sqlite3
